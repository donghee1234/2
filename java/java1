import java.util.InputMismatchException;
import java.util.Scanner;

/*
 * [4강 실습] 영화관 좌석 예약 시스템 (리팩터링 전)
 * 5x8 좌석을 int[][]로 관리한다. (0 = 빈 좌석 O, 1 = 예약 좌석 X)
 * 메뉴: 1 현황 / 2 예약 / 3 취소 / 4 통계 / 5(또는 0) 종료
 *
 * [고찰]
 * 모든 기능을 main() 하나에 작성해서 길고 흐름을 파악하기 어렵다.
 * 예약/취소의 행·열 입력과 범위 검사가 거의 똑같이 반복되어 수정할 때 실수하기 쉽다.
 * => 기능별로 메서드를 분리하는 리팩터링이 필요하다.
 */
public class MovieSeatReservation {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // 5행 x 8열 좌석 배열 (생성 시 모든 값이 0 = 빈 좌석으로 초기화된다)
        int[][] seats = new int[5][8];

        // 종료를 선택할 때까지 메뉴를 반복한다.
        while (true) {
            // 메뉴 출력
            System.out.println("========== 영화관 좌석 예약 ==========");
            System.out.println("1. 좌석 현황 보기");
            System.out.println("2. 좌석 예약");
            System.out.println("3. 예약 취소");
            System.out.println("4. 예약 현황 통계");
            System.out.println("5. 종료");
            System.out.println("================================");
            System.out.print("메뉴 선택 : ");

            try {
                int menu = scanner.nextInt();

                if (menu == 0 || menu == 5) {
                    // 종료
                    System.out.println("프로그램을 종료합니다.");
                    break;

                } else if (menu == 1) {
                    // 좌석 현황 보기: 빈 좌석은 O, 예약된 좌석은 X로 출력
                    System.out.println("     1 2 3 4 5 6 7 8");
                    System.out.println("--------------------------");
                    for (int i = 0; i < 5; i++) {
                        System.out.print((i + 1) + "열  ");
                        for (int j = 0; j < 8; j++) {
                            if (seats[i][j] == 0) {
                                System.out.print("O ");
                            } else {
                                System.out.print("X ");
                            }
                        }
                        System.out.println();
                    }

                } else if (menu == 2) {
                    // 좌석 예약: 사용자는 1부터 입력하므로 배열에 접근할 때는 1을 뺀다.
                    System.out.print("예약할 행: ");
                    int row = scanner.nextInt();
                    System.out.print("좌석 번호: ");
                    int col = scanner.nextInt();

                    if (row < 1 || row > 5 || col < 1 || col > 8) {
                        // 범위를 벗어난 입력
                        System.out.println(">> 잘못된 좌석 번호입니다. (행: 1~5, 좌석: 1~8)");
                    } else if (seats[row - 1][col - 1] == 1) {
                        // 이미 예약된 좌석
                        System.out.println(">> 이미 예약된 좌석입니다.");
                    } else {
                        seats[row - 1][col - 1] = 1;
                        System.out.println(">> " + row + "행 " + col + "번 좌석이 예약되었습니다.");
                    }

                } else if (menu == 3) {
                    // 예약 취소: 예약 때와 같은 방식으로 입력받고 검사한다. (코드가 반복되는 부분)
                    System.out.print("취소할 행: ");
                    int row = scanner.nextInt();
                    System.out.print("좌석 번호: ");
                    int col = scanner.nextInt();

                    if (row < 1 || row > 5 || col < 1 || col > 8) {
                        System.out.println(">> 잘못된 좌석 번호입니다. (행: 1~5, 좌석: 1~8)");
                    } else if (seats[row - 1][col - 1] == 0) {
                        // 예약되지 않은 빈 좌석
                        System.out.println(">> 예약되지 않은 좌석입니다.");
                    } else {
                        seats[row - 1][col - 1] = 0;
                        System.out.println(">> " + row + "행 " + col + "번 좌석 예약이 취소되었습니다.");
                    }

                } else if (menu == 4) {
                    // 예약 현황 통계: 전체 / 예약 / 남은 좌석, 예약률, 행별 예약 수
                    int total = 5 * 8;
                    int reserved = 0;
                    int[] rowCount = new int[5];   // 각 행의 예약 좌석 수

                    for (int i = 0; i < 5; i++) {
                        for (int j = 0; j < 8; j++) {
                            if (seats[i][j] == 1) {
                                reserved++;
                                rowCount[i]++;
                            }
                        }
                    }

                    int remain = total - reserved;
                    // 정수끼리 나누면 소수점이 버려지므로 double로 형변환한다.
                    double rate = (double) reserved / total * 100;

                    System.out.println("====== 예약 현황 =====");
                    System.out.println("전체 좌석 : " + total + "석");
                    System.out.println("예약 좌석 : " + reserved + "석");
                    System.out.println("남은 좌석 : " + remain + "석");
                    System.out.printf("예약률    : %.1f%%%n", rate);
                    System.out.println();
                    for (int i = 0; i < 5; i++) {
                        System.out.println((i + 1) + "행 예약 : " + rowCount[i] + "석");
                    }
                    System.out.println("==================");

                } else {
                    // 메뉴 번호가 아닌 숫자
                    System.out.println(">> 잘못된 메뉴입니다. 다시 선택해주세요.");
                }

            } catch (InputMismatchException e) {
                // 숫자가 아닌 입력은 버리고 메뉴로 돌아간다.
                System.out.println(">> 숫자만 입력할 수 있습니다.");
                scanner.nextLine();
            }

            System.out.println();
        }

        scanner.close();
    }
}
