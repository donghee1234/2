import java.util.Scanner;

/*
 * [5강 과제] 영화관 좌석 예약 시스템 리팩터링
 * 기능은 그대로 두고 main()을 출력/예약/취소/통계 메서드로 분리했다.
 * Challenge: 예약률 계산 분리, 가장 여유로운 행 찾기 추가, 입력 검증 코드 통합(readValidSeat)
 *
 * [고찰]
 * main()에서 메뉴 흐름과 메서드 호출만 보여서 main()만 읽어도 전체 흐름이 설명된다.
 * 행/열 범위 검사가 isValidSeat()와 readValidSeat()에만 있어 수정할 곳이 줄었다.
 * 메서드마다 한 가지 일만 하므로 오류가 났을 때 원인을 찾고 고치기 쉬워졌다.
 */
public class MovieSeatReservationRefactored {

    // 좌석 크기와 상태 값을 상수로 두어 숫자의 의미가 바로 보이게 했다.
    static final int ROWS = 5;
    static final int COLS = 8;
    static final int EMPTY = 0;      // 빈 좌석
    static final int RESERVED = 1;   // 예약된 좌석

    // main: 메뉴 흐름과 메서드 호출만 남겼다.
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int[][] seats = new int[ROWS][COLS];

        while (true) {
            printMenu();
            int menu = readInt(scanner);

            switch (menu) {
                case 1 -> printSeats(seats);                       // 좌석 현황
                case 2 -> processReservation(scanner, seats);      // 예약
                case 3 -> processCancellation(scanner, seats);     // 취소
                case 4 -> printStatistics(seats);                  // 통계
                case 0, 5 -> {                                     // 종료
                    System.out.println("프로그램을 종료합니다.");
                    scanner.close();
                    return;
                }
                default -> System.out.println(">> 잘못된 메뉴입니다. 다시 선택해주세요.");
            }
            System.out.println();
        }
    }

    // 메뉴 화면을 출력한다.
    static void printMenu() {
        System.out.println("========== 영화관 좌석 예약 ==========");
        System.out.println("1. 좌석 현황 보기");
        System.out.println("2. 좌석 예약");
        System.out.println("3. 예약 취소");
        System.out.println("4. 예약 현황 통계");
        System.out.println("5. 종료");
        System.out.println("================================");
        System.out.print("메뉴 선택 : ");
    }

    // 좌석 현황을 출력한다. (빈 좌석 O, 예약된 좌석 X)
    static void printSeats(int[][] seats) {
        System.out.println("     1 2 3 4 5 6 7 8");
        System.out.println("--------------------------");
        for (int i = 0; i < seats.length; i++) {
            System.out.print((i + 1) + "열  ");
            for (int j = 0; j < seats[i].length; j++) {
                System.out.print(seats[i][j] == EMPTY ? "O " : "X ");
            }
            System.out.println();
        }
    }

    // 좌석이 배열 범위 안에 있는지 검사한다. (row, col은 0부터 시작하는 인덱스 기준)
    static boolean isValidSeat(int[][] seats, int row, int col) {
        return row >= 0 && row < seats.length
                && col >= 0 && col < seats[row].length;
    }

    // 좌석을 예약한다. 성공하면 true, 이미 예약된 좌석이면 false를 반환한다.
    // [배열을 전달하면 원본이 수정되는 이유]
    // 배열은 참조 타입이라 seats에는 배열 객체의 주소가 들어 있다.
    // 메서드를 호출하면 이 주소가 매개변수로 복사되어 main()의 seats와 같은 배열을 가리킨다.
    // 따라서 seats[row][col]을 바꾸면 원본도 바뀐다. (int row, col 같은 기본형은 값이 복사되어 원본에 영향이 없다.)
    static boolean reserveSeat(int[][] seats, int row, int col) {
        if (!isValidSeat(seats, row, col) || seats[row][col] == RESERVED) {
            return false;
        }
        seats[row][col] = RESERVED;
        return true;
    }

    // 예약을 취소한다. 성공하면 true, 예약되지 않은 빈 좌석이면 false를 반환한다.
    // (reserveSeat와 같은 이유로 원본 배열이 수정된다.)
    static boolean cancelSeat(int[][] seats, int row, int col) {
        if (!isValidSeat(seats, row, col) || seats[row][col] == EMPTY) {
            return false;
        }
        seats[row][col] = EMPTY;
        return true;
    }

    // 숫자가 입력될 때까지 다시 입력받아 정수를 반환한다.
    static int readInt(Scanner scanner) {
        while (!scanner.hasNextInt()) {
            scanner.next();   // 숫자가 아닌 입력은 버린다.
            System.out.print(">> 숫자를 입력하세요: ");
        }
        return scanner.nextInt();
    }

    // 행과 좌석 번호를 입력받아 검사한다. (예약/취소에서 반복되던 코드를 통합)
    // 올바른 좌석이면 {행, 열} 인덱스를, 잘못된 좌석이면 null을 반환한다.
    static int[] readValidSeat(Scanner scanner, int[][] seats, String rowPrompt) {
        System.out.print(rowPrompt);
        int row = readInt(scanner) - 1;      // 사용자는 1부터 입력하므로 1을 뺀다.
        System.out.print("좌석 번호: ");
        int col = readInt(scanner) - 1;

        if (!isValidSeat(seats, row, col)) {
            System.out.println(">> 잘못된 좌석 번호입니다. (행: 1~" + seats.length
                    + ", 좌석: 1~" + seats[0].length + ")");
            return null;
        }
        return new int[] { row, col };
    }

    // 예약 메뉴 처리: 입력 -> 예약 -> 결과 메시지
    static void processReservation(Scanner scanner, int[][] seats) {
        int[] pos = readValidSeat(scanner, seats, "예약할 행: ");
        if (pos == null) {
            return;   // 잘못된 좌석이면 오류 메시지를 이미 출력했다.
        }
        if (reserveSeat(seats, pos[0], pos[1])) {
            System.out.println(">> " + (pos[0] + 1) + "행 " + (pos[1] + 1) + "번 좌석이 예약되었습니다.");
        } else {
            System.out.println(">> 이미 예약된 좌석입니다.");
        }
    }

    // 취소 메뉴 처리: 입력 -> 취소 -> 결과 메시지
    static void processCancellation(Scanner scanner, int[][] seats) {
        int[] pos = readValidSeat(scanner, seats, "취소할 행: ");
        if (pos == null) {
            return;
        }
        if (cancelSeat(seats, pos[0], pos[1])) {
            System.out.println(">> " + (pos[0] + 1) + "행 " + (pos[1] + 1) + "번 좌석 예약이 취소되었습니다.");
        } else {
            System.out.println(">> 예약되지 않은 좌석입니다.");
        }
    }

    // 전체 좌석 수를 반환한다.
    static int countTotalSeats(int[][] seats) {
        return seats.length * seats[0].length;
    }

    // 특정 행의 예약된 좌석 수를 반환한다.
    static int countReservedInRow(int[][] seats, int row) {
        int count = 0;
        for (int j = 0; j < seats[row].length; j++) {
            if (seats[row][j] == RESERVED) {
                count++;
            }
        }
        return count;
    }

    // 전체 예약된 좌석 수를 반환한다. (행별 개수를 더한다.)
    static int countReserved(int[][] seats) {
        int count = 0;
        for (int i = 0; i < seats.length; i++) {
            count += countReservedInRow(seats, i);
        }
        return count;
    }

    // 예약률(%)을 계산한다. (정수 나눗셈을 피하려고 double로 형변환)
    static double calculateReservationRate(int[][] seats) {
        return (double) countReserved(seats) / countTotalSeats(seats) * 100;
    }

    // 예약이 가장 적은 행의 인덱스를 반환한다. (같으면 앞의 행)
    static int findMostAvailableRow(int[][] seats) {
        int best = 0;
        for (int i = 1; i < seats.length; i++) {
            if (countReservedInRow(seats, i) < countReservedInRow(seats, best)) {
                best = i;
            }
        }
        return best;
    }

    // 예약 현황 통계를 출력한다. (계산은 위 메서드에 맡기고 여기서는 출력만 한다.)
    static void printStatistics(int[][] seats) {
        int total = countTotalSeats(seats);
        int reserved = countReserved(seats);

        System.out.println("====== 예약 현황 =====");
        System.out.println("전체 좌석 : " + total + "석");
        System.out.println("예약 좌석 : " + reserved + "석");
        System.out.println("남은 좌석 : " + (total - reserved) + "석");
        System.out.printf("예약률    : %.1f%%%n", calculateReservationRate(seats));
        System.out.println();

        for (int i = 0; i < seats.length; i++) {
            System.out.println((i + 1) + "행 예약 : " + countReservedInRow(seats, i) + "석");
        }

        int best = findMostAvailableRow(seats);
        System.out.println("가장 여유로운 행 : " + (best + 1) + "행 (남은 좌석 "
                + (seats[best].length - countReservedInRow(seats, best)) + "석)");
        System.out.println("==================");
    }
}
